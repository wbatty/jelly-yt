# --- Telegram ---------------------------------------------------------------
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
# Comma-separated Telegram user IDs allowed to use the bot (everyone else is ignored)
ALLOWED_TELEGRAM_USER_IDS=123456789

# --- Where the bot writes playlists and single videos ------------------------
# Paths are as seen inside the bot container. Add this folder to Jellyfin as
# its own "Shows" library (e.g. one only the kids' account can see).
MEDIA_ROOT=/media/YoutubeCurated
# DATABASE_PATH=/media/YoutubeCurated/.jelly-yt/state.db

# --- ytdlp2STRM ---------------------------------------------------------------
# Base URL written into every .strm file. Use exactly what ytdlp2STRM writes into
# its own .strm files (open one and copy the part before /youtube/...).
YTDLP2STRM_URL=http://192.168.1.10:5005
# YTDLP2STRM_METHOD=direct          # direct | bridge
# ytdlp2STRM's plugins/youtube/channel_list.json, mounted into this container
YTDLP2STRM_CHANNEL_LIST=/config/channel_list.json

# --- Jellyfin (optional, for an immediate scan after adding something) -------
JELLYFIN_URL=http://192.168.1.10:8096
JELLYFIN_API_KEY=your_admin_api_token_here
# MEDIA_ROOT as seen by the Jellyfin server; enables a fast targeted scan
# JELLYFIN_MEDIA_ROOT=/media/YoutubeCurated

# --- Misc ----------------------------------------------------------------------
# COOKIES_PATH=/config/cookies.txt  # for private playlists / age-restricted videos
# PLAYLIST_SYNC_INTERVAL_MINUTES=60
# LOG_LEVEL=INFO

# --- docker-compose only -------------------------------------------------------
MEDIA_HOST=/srv/media
CHANNEL_LIST_HOST=./ytdlp2strm/channel_list.json
PUID=1000
PGID=1000
