# Storage & Paths (paths as seen *inside* the containers)
MEDIA_ROOT=/srv/media/youtube
COOKIES_PATH=/srv/media/youtube/cookies.txt
DATABASE_PATH=/srv/media/youtube/data/seen.db

# Host directory mounted at MEDIA_ROOT by docker-compose, and its owner
MEDIA_ROOT_HOST=/srv/media/youtube
PUID=1000
PGID=1000

# Proxy Settings
# PROXY_HOST/PROXY_PORT are written into every .strm file, so they must be
# reachable from the Jellyfin server (use a LAN IP/hostname, not 127.0.0.1,
# unless Jellyfin runs on the host network of the same machine).
PROXY_HOST=127.0.0.1
PROXY_PORT=8080
# PROXY_PUBLIC_URL=http://yt-proxy.lan:8080   # overrides PROXY_HOST/PORT in .strm files
# PROXY_MODE=redirect                         # redirect (HTTP 302) | stream (reverse proxy)
# PROXY_FORMAT=                               # custom yt-dlp format selector

# Jellyfin Integration
JELLYFIN_URL=http://127.0.0.1:8096
JELLYFIN_API_KEY=your_admin_api_token_here
# Path of MEDIA_ROOT inside the Jellyfin server. When set, scans are targeted
# (/Library/Media/Updated) instead of a full /Library/Refresh – much faster.
# JELLYFIN_MEDIA_ROOT=/srv/media/youtube

# Telegram Ingest Bot
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
ALLOWED_TELEGRAM_USER_ID=123456789

# Sync Behavior
INITIAL_BACKFILL_LIMIT=10
POLL_INTERVAL_MINUTES=60
# FEED_CONCURRENCY=16
# PLAYLIST_FULL_RESYNC_HOURS=24
# LOG_LEVEL=INFO
